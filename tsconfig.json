{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": [
      "bun"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@notes/html-generator": [
        "./node_modules/@notes/html-generator/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "scripts"
  ]
}
